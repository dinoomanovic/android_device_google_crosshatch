From 12741629dfeb1ab940457749686c6b190d1320ba Mon Sep 17 00:00:00 2001
From: Ella Song <mobile_hacker_15@hotmail.com>
Date: Mon, 21 Sep 2026 23:57:16 +0200
Subject: [PATCH] Connectivity: checkpoint legacy kernel BPF bring-up
 workarounds

Preserve the current LineageOS 23.0 crosshatch development checkpoint. Companion changes are required across repositories. This checkpoint does not establish release readiness; unresolved runtime and policy-enforcement issues are documented in the device repository BRINGUP.md.

Change-Id: Ib9ef50e1618f465d7249d49029bf327ea7cb2899

diff --git a/bpf/headers/include/bpf/BpfMap.h b/bpf/headers/include/bpf/BpfMap.h
index 576cca6f884c62c71a726d5a3d6e7dc26a35ee04..e2d18ec2e79031d9f59db7492f07a9852d40a919 100644
--- a/bpf/headers/include/bpf/BpfMap.h
+++ b/bpf/headers/include/bpf/BpfMap.h
@@ -85,21 +85,16 @@ class BpfMapRO {
 
   protected:
     void abortOnMismatch(bool writable) const {
-        if (!mMapFd.ok()) Abort(errno, "mMapFd %d is not valid", mMapFd.get());
+        if (!mMapFd.ok()) return;
         if (isAtLeastKernelVersion(4, 14, 0)) {
             int flags = bpfGetFdMapFlags(mMapFd);
-            if (flags < 0) Abort(errno, "bpfGetFdMapFlags fail: flags=%d", flags);
-            if (flags & BPF_F_WRONLY) Abort(0, "map is write-only (flags=0x%X)", flags);
-            if (writable && (flags & BPF_F_RDONLY))
-                Abort(0, "writable map is actually read-only (flags=0x%X)", flags);
+            if (flags < 0) return;
+            if (flags & BPF_F_WRONLY) return;
+            if (writable && (flags & BPF_F_RDONLY)) return;
             int keySize = bpfGetFdKeySize(mMapFd);
-            if (keySize != sizeof(Key))
-                Abort(errno, "map key size mismatch (expected=%zu, actual=%d)",
-                      sizeof(Key), keySize);
+            if (keySize != sizeof(Key)) return;
             int valueSize = bpfGetFdValueSize(mMapFd);
-            if (valueSize != sizeof(Value))
-                Abort(errno, "map value size mismatch (expected=%zu, actual=%d)",
-                      sizeof(Value), valueSize);
+            if (valueSize != sizeof(Value)) return;
         }
     }
 
