From 090cf19a04d0010ab5a4e4d49a9b66a40c8cf46a Mon Sep 17 00:00:00 2001
From: Ella Song <mobile_hacker_15@hotmail.com>
Date: Mon, 21 Sep 2026 23:57:16 +0200
Subject: [PATCH] DnsResolver: checkpoint legacy kernel DNS helper fallback

Preserve the current LineageOS 23.0 crosshatch development checkpoint. Companion changes are required across repositories. This checkpoint does not establish release readiness; unresolved runtime and policy-enforcement issues are documented in the device repository BRINGUP.md.

Change-Id: Ic1536ccc788a1ffa32bf50e11e5cbd1dbfd52759

diff --git a/DnsProxyListener.cpp b/DnsProxyListener.cpp
index 302cfd99e02ca597889da96795f35bf5f43c5e38..c1346fbfad4da617956b9582453994d183234ad4 100644
--- a/DnsProxyListener.cpp
+++ b/DnsProxyListener.cpp
@@ -690,10 +690,9 @@ IsUidBlockedFn resolveIsUidNetworkingBlockedFn() {
     }
     const int ret = (*ADnsHelper_init)();
     if (ret) {
-        // On S/Sv2 this can fail if tethering apex is too old, ignore it.
-        if (ret == -EOPNOTSUPP && !isAtLeastT()) return nullptr;
-        LOG(ERROR) << __func__ << ": ADnsHelper_init failed " << strerror(-ret);
-        abort();
+        LOG(WARNING) << __func__ << ": ADnsHelper_init failed " << strerror(-ret)
+                     << ", continuing without DNS UID blocking on legacy kernel";
+        return nullptr;
     }
 
     // Related BPF maps were only mainlined from T.
