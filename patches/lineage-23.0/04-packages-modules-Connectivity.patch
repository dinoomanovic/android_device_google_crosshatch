+    private static class MemBpfMap<K extends Struct, V extends Struct> implements IBpfMap<K, V> {
+        private final java.util.concurrent.ConcurrentHashMap<K, V> mMap = new java.util.concurrent.ConcurrentHashMap<>();
+
+        @Override public void updateEntry(K key, V value) { mMap.put(key, value); }
+        @Override public void insertEntry(K key, V value) { mMap.put(key, value); }
+        @Override public void replaceEntry(K key, V value) { mMap.put(key, value); }
+        @Override public boolean insertOrReplaceEntry(K key, V value) {
+            boolean ret = !mMap.containsKey(key);
+            mMap.put(key, value);
+            return ret;
+        }
+        @Override public boolean deleteEntry(K key) { return mMap.remove(key) != null; }
+        @Override public K getNextKey(K key) { return null; }
+        @Override public K getFirstKey() { return null; }
+        @Override public boolean isEmpty() { return mMap.isEmpty(); }
+        @Override public boolean containsKey(K key) { return mMap.containsKey(key); }
+        @Override public V getValue(K key) { return mMap.get(key); }
+        @Override public void forEach(ThrowingBiConsumer<K, V> action) throws ErrnoException {
+            for (java.util.Map.Entry<K, V> entry : mMap.entrySet()) {
+                action.accept(entry.getKey(), entry.getValue());
+            }
+        }
+        @Override public void clear() { mMap.clear(); }
+        @Override public void close() {}
+    }
