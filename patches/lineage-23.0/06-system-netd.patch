From d8c142a05e5af45a922d5cd5e42a6e6433b562c1 Mon Sep 17 00:00:00 2001
From: Ella Song <mobile_hacker_15@hotmail.com>
Date: Mon, 21 Sep 2026 23:57:16 +0200
Subject: [PATCH] netd: checkpoint bandwidth initialization workaround

Preserve the current LineageOS 23.0 crosshatch development checkpoint. Companion changes are required across repositories. This checkpoint does not establish release readiness; unresolved runtime and policy-enforcement issues are documented in the device repository BRINGUP.md.

Change-Id: I44b90a9c0b957717f35a6abfe61814aafde10846

diff --git a/server/Controllers.cpp b/server/Controllers.cpp
index 48d0c509a5cecc0f0869847734074d25251554ad..22af8722fd8cb49656d794d1b979a2d4bd0f85f1 100644
--- a/server/Controllers.cpp
+++ b/server/Controllers.cpp
@@ -320,13 +320,7 @@ void Controllers::init() {
     Stopwatch s;
 
     if (int ret = bandwidthCtrl.enableBandwidthControl()) {
-        gLog.error("Failed to initialize BandwidthController (%s)", strerror(-ret));
-        // A failure to init almost definitely means that iptables failed to load
-        // our static ruleset, which then basically means network accounting will not work.
-        // As such simply exit netd.  This may crash loop the system, but by failing
-        // to bootup we will trigger rollback and thus this offers us protection against
-        // a mainline update breaking things.
-        exit(1);
+        gLog.error("Failed to initialize BandwidthController (%s), continuing on legacy kernel", strerror(-ret));
     }
     gLog.info("Enabling bandwidth control: %" PRId64 "us", s.getTimeAndResetUs());
 
